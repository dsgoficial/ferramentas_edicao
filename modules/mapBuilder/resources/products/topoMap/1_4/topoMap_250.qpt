 <LayoutItem htmlState="1" marginY="0" frameJoinStyle="miter" positionLock="false" valign="32" uuid="{4856c010-2688-4041-874f-fac854f19d1a}" groupUuid="" excludeFromExports="0" labelText="&lt;!DOCTYPE html&#xa;&#x9;PUBLIC &quot;-//W3C//DTD XHTML 1.0 Transitional//EN&quot; &quot;http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd&quot;>&#xa;&lt;html xmlns=&quot;http://www.w3.org/1999/xhtml&quot;>&#xa;&#xa;&lt;head>&#xa;&#x9;&lt;meta charset=&quot;utf-8&quot; name=&quot;viewport&quot; content=&quot;maximum-scale=1&quot;>&#xa;&lt;/head>&#xa;&lt;style>&#xa;&#x9;page,&#xa;&#x9;body,&#xa;&#x9;div {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;height: 100%;&#xa;&#x9;&#x9;margin: 0px 0px 0px 0px;&#xa;&#x9;&#x9;margin-right: 0mm;&#xa;&#x9;&#x9;padding: 0px 0px 0px 0px;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;border-collapse: collapse;&#xa;&#x9;&#x9;border: 0.09em solid;&#xa;&#x9;&#x9;font-size: 0.7em;&#xa;&#x9;&#x9;columns: 3;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao tr td.lef {&#xa;&#x9;&#x9;width: 41%;&#xa;&#x9;&#x9;border: 0.06em solid;&#xa;&#x9;&#x9;text-align: left;&#xa;&#x9;&#x9;padding-top: 0.18em;&#xa;&#x9;&#x9;padding-bottom: 0.18em;&#xa;&#x9;&#x9;padding-left: 0.4em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao tr td.mid {&#xa;&#x9;&#x9;width: 48%;&#xa;&#x9;&#x9;border: 0.06em solid;&#xa;&#x9;&#x9;text-align: left;&#xa;&#x9;&#x9;padding-top: 0.18em;&#xa;&#x9;&#x9;padding-bottom: 0.18em;&#xa;&#x9;&#x9;padding-left: 0.4em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao tr td.rig {&#xa;&#x9;&#x9;width: 11%;&#xa;&#x9;&#x9;border: 0.16mm solid;&#xa;&#x9;&#x9;line-height: 1.2;&#xa;&#x9;&#x9;text-align: center;&#xa;&#x9;&#x9;padding-top: 0.5mm;&#xa;&#x9;&#x9;padding-bottom: 0.5mm;&#xa;&#x9;&#x9;padding-left: 0;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table#obs {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;border-collapse: collapse;&#xa;&#x9;&#x9;border: 0px solid;&#xa;&#x9;&#x9;font-size: 0.64em;&#xa;&#x9;&#x9;columns: 1;&#xa;&#x9;&#x9;font-family: Noto Sans;&#xa;&#x9;}&#xa;&#xa;&#x9;table#obs tr td.fases {&#xa;&#x9;&#x9;border: 0px solid;&#xa;&#x9;&#x9;color: black;&#xa;&#x9;&#x9;padding-top: 0.6em;&#xa;&#x9;&#x9;padding-bottom: 0.3em;&#xa;&#x9;&#x9;padding-left: 0.5em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;&#x9;font-size: 0.88em;&#xa;&#x9;}&#xa;&#xa;&#x9;table#obs tr td.origem {&#xa;&#x9;&#x9;width: 60%;&#xa;&#x9;&#x9;border: 0px solid;&#xa;&#x9;&#x9;padding-top: 0.6em;&#xa;&#x9;&#x9;padding-bottom: 0;&#xa;&#x9;&#x9;padding-left: 0.5em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table th {&#xa;&#x9;&#x9;font-weight: bold;&#xa;&#x9;&#x9;font-size: 1.39em;&#xa;&#x9;&#x9;text-transform: uppercase;&#xa;&#x9;&#x9;padding: 0.34em;&#xa;&#x9;}&#xa;&lt;/style>&#xa;&lt;page id=&quot;rodamao&quot; style=&quot;&#xa;    width: 104mm;&quot;>&#xa;&#xa;&#x9;&lt;body id=&quot;direito&quot;>&#xa;&#x9;&#x9;&lt;div align=&quot;center&quot;>&#xa;&#x9;&#x9;&#x9;&lt;table id=&quot;producao&quot;>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;tr>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;span>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;th colspan=&quot;3&quot;>fases da produção&lt;/th>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;/span>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;/tr>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;tr style=&quot;font-weight:bold;&quot;>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;td class=&quot;lef&quot; style=&quot;text-align: center;&quot;>FASES&lt;/td>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;td class=&quot;mid&quot; style=&quot;text-align: center;&quot;>EXECUTANTES&lt;/td>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;td class=&quot;rig&quot; style=&quot;text-align: center;&quot;>DATAS&lt;/td>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;/tr>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;tr>&#xa;&#x9;&lt;td class = &quot;lef&quot; rowspan=&quot;1&quot;>Imageamento&lt;/td>&#xa;&#x9;&lt;td class = &quot;mid&quot; >INPE e CAST&lt;/td>&#xa;&#x9;&lt;td class = &quot;rig&quot; >2020 a 2021&lt;/td>&#xa;&#x9;&lt;/tr>&#xa;&lt;tr>&#xa;&#x9;&lt;td class = &quot;lef&quot; rowspan=&quot;1&quot;>Processamento Digital de Imagens&lt;/td>&#xa;&#x9;&lt;td class = &quot;mid&quot; >Diretoria de Serviço Geográfico - 1º CGEO&lt;/td>&#xa;&#x9;&lt;td class = &quot;rig&quot; >07/2022&lt;/td>&#xa;&#x9;&lt;/tr>&#xa;&lt;tr>&#xa;&#x9;&lt;td class = &quot;lef&quot; rowspan=&quot;1&quot;>Aquisição Vetorial&lt;/td>&#xa;&#x9;&lt;td class = &quot;mid&quot; >Diretoria de Serviço Geográfico - 1º CGEO&lt;/td>&#xa;&#x9;&lt;td class = &quot;rig&quot; >08/2022&lt;/td>&#xa;&#x9;&lt;/tr>&#xa;&lt;tr>&#xa;&#x9;&lt;td class = &quot;lef&quot; rowspan=&quot;1&quot;>Validação&lt;/td>&#xa;&#x9;&lt;td class = &quot;mid&quot; >Diretoria de Serviço Geográfico - 1º CGEO&lt;/td>&#xa;&#x9;&lt;td class = &quot;rig&quot; >09/2022&lt;/td>&#xa;&#x9;&lt;/tr>&#xa;&lt;tr>&#xa;&#x9;&lt;td class = &quot;lef&quot; rowspan=&quot;1&quot;>Edição&lt;/td>&#xa;&#x9;&lt;td class = &quot;mid&quot; >Diretoria de Serviço Geográfico - 1º CGEO&lt;/td>&#xa;&#x9;&lt;td class = &quot;rig&quot; >09/2022&lt;/td>&#xa;&#x9;&lt;/tr>&#xa;&lt;/table>&#xa;&#x9;&#x9;&lt;/div>&#xa;&#x9;&lt;/body>&#xa;&lt;/page>&#xa;&#xa;&lt;/html>" zValue="401" marginX="0" positionOnPage="542,540,mm" id="label_tabela_etapas" type="65641" blendMode="0" position="542,540,mm" referencePoint="1" halign="132" opacity="1" visibility="1" background="false" templateUuid="{4856c010-2688-4041-874f-fac854f19d1a}" frame="false" outlineWidthM="0.3,mm" size="110,41,mm" itemRotation="0">
