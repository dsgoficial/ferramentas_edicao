 <LayoutMultiFrame contentMode="1" evaluateExpressions="true" html="&lt;html>&#xa;&#xa;&lt;head>&#xa;&#x9;&lt;meta name=&quot;viewport&quot; content=&quot;maximum-scale=1&quot; charset=&quot;utf-8&quot;>&#xa;&lt;/head>&#xa;&lt;style>&#xa;&#x9;page,&#xa;&#x9;body,&#xa;&#x9;div {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;height: 100%;&#xa;&#x9;&#x9;margin: 0px 0px 0px 0px;&#xa;&#x9;&#x9;padding: 0px 0px 0px 0px;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;border-collapse: collapse;&#xa;&#x9;&#x9;border: 0.09em solid;&#xa;&#x9;&#x9;font-size: 0.7em;&#xa;&#x9;&#x9;columns: 3;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao tr td.left {&#xa;&#x9;&#x9;width: 40%;&#xa;&#x9;&#x9;border: 0.06em solid;&#xa;&#x9;&#x9;text-align: left;&#xa;&#x9;&#x9;padding-top: 0.18em;&#xa;&#x9;&#x9;padding-bottom: 0.18em;&#xa;&#x9;&#x9;padding-left: 0.4em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table#producao tr td.right {&#xa;&#x9;&#x9;border: 0.06em solid;&#xa;&#x9;&#x9;text-align: left;&#xa;&#x9;&#x9;padding-top: 0.18em;&#xa;&#x9;&#x9;padding-bottom: 0.18em;&#xa;&#x9;&#x9;padding-left: 0.4em;&#xa;&#x9;&#x9;padding-right: 0;&#xa;&#x9;}&#xa;&#xa;&#x9;table#obs {&#xa;&#x9;&#x9;width: 100%;&#xa;&#x9;&#x9;border-collapse: collapse;&#xa;&#x9;&#x9;border: 0px solid;&#xa;&#x9;&#x9;font-size: 0.64em;&#xa;&#x9;&#x9;columns: 1;&#xa;&#x9;&#x9;font-family: Noto Sans;&#xa;&#x9;}&#xa;&#xa;&#x9;table#obs tr td.phases {&#xa;&#x9;&#x9;border: 0px solid;&#xa;&#x9;&#x9;color: black;&#xa;&#x9;&#x9;padding-top: 0;&#xa;&#x9;&#x9;padding-bottom: 0;&#xa;&#x9;&#x9;padding-left: 0.4em;&#xa;&#x9;}&#xa;&#xa;&#x9;table th {&#xa;&#x9;&#x9;font-weight: bold;&#xa;&#x9;&#x9;font-size: 1.39em;&#xa;&#x9;&#x9;text-transform: uppercase;&#xa;&#x9;&#x9;padding: 0.34em;&#xa;&#x9;}&#xa;&lt;/style>&#xa;&#xa;&lt;page id=&quot;rodamao&quot; style=&quot;width: 104mm;&quot;>&#xa;&#xa;&#x9;&lt;body>&#xa;&#x9;&#x9;&lt;div align=&quot;center&quot;>&#xa;&#x9;&#x9;&#x9;&lt;table id=&quot;producao&quot;>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;tr>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;span>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;th colspan=&quot;2&quot;>informações técnicas do Produto&lt;/th>&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&lt;/span>&#xa;&#x9;&#x9;&#x9;&#x9;&lt;/tr>&#xa;&#x9;&#x9;&#x9;&lt;tr>&lt;td class=&quot;left&quot;>Projeção&lt;/td>&lt;td class=&quot;right&quot;>Universal Transversa de Mercator&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot; rowspan=&quot;2&quot;>Origem UTM&lt;/td>&lt;td class=&quot;right&quot;>Hemisfério Norte. Equador: + 0 Km&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;right&quot;>Zona 20. Meridiano Central -63 º W Gr.: + 500 Km&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot;>Datum horizontal&lt;/td>&lt;td class=&quot;right&quot;>SIRGAS2000 (Época 2000.4)&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot; rowspan=&quot;2&quot;>Equidistância das curvas de nível&lt;/td>&lt;td class=&quot;right&quot;>Normal: 20 metros&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;right&quot;>Mestra: 100 metros&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot;>Erro gráfico&lt;/td>&lt;td class=&quot;right&quot;>0,2 mm na escala&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot; rowspan=&quot;2&quot;>Padrão de Exatidão Cartográfica (PEC)&lt;/td>&lt;td class=&quot;right&quot;>PEC Planimétrico: B (derivado da ortoimagem)&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;right&quot;>PEC Altimétrico: B (derivado da MDE)&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot;>Especificação técnica de representação&lt;/td>&lt;td class=&quot;right&quot;>Norma da Especificação Técnica para Representação de Dados Geoespaciais versão 1.0 (EB80-N-72.006)&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot;>Origem dos dados altimétricos&lt;/td>&lt;td class=&quot;right&quot;>GLO-30 com correção do efeito do dossel vegetativo&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;left&quot; rowspan=&quot;4&quot;>Origem dos dados geoespaciais fornecidos por terceiros&lt;/td>&lt;td class=&quot;right&quot;>Limites internacionais: CBDL*&lt;/td>&lt;tr>&lt;td class=&quot;right&quot;>Limites estaduais e municipais: IBGE* / 2020&lt;/td>&lt;/tr>&lt;/tr>&lt;tr>&lt;td class=&quot;right&quot;>Modelo geoidal: EGM2008 - ICGEM&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;right&quot;>Declinação magnética: NOAA (WMM 2020-2025)&lt;/td>&lt;/tr>&lt;/table>&#xa;&#x9;&#x9;&#x9;&lt;table id=&quot;obs&quot;>&#xa;&#x9;&#x9;&#x9;&lt;tr>&lt;td class=&quot;phases&quot;>* Limites sujeitos à homologação do referido órgão.&lt;/td>&lt;/tr>&lt;tr>&lt;td class=&quot;phases&quot;>Para mais informações, consulte o arquivo de metadados.&lt;/td>&lt;/tr>&lt;/table>&#xa;&#x9;&#x9;&lt;/div>&#xa;&#x9;&lt;/body>&#xa;&lt;/page>&#xa;&#xa;&lt;/html>" maxBreakDistance="10" resizeMode="0" stylesheet="body { margin: 0 0;line-height: 122%;color: rgba(0,0,0,1.0000);font-family: Noto Sans;font-style: normal;font-weight: 400;font-size: 14.6991px;text-align: justify; }" stylesheetEnabled="true" templateUuid="{0abfe773-fc6b-40ba-8d57-2e1e29134309}" type="65648" url="" useSmartBreaks="true" uuid="{0abfe773-fc6b-40ba-8d57-2e1e29134309}">
